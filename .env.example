# ============================================================
# TenantMind - Environment Configuration Template
# ============================================================
# Copy this file to `.env` and fill in real values:
#
#     cp .env.example .env
#
# `.env` is gitignored and must NEVER be committed.
#
# Every credential below is left EMPTY on purpose. There are no real
# secrets in this file.
#
# PRECEDENCE (pydantic-settings default, highest first):
#
#     1. environment variables
#     2. this .env file
#     3. the defaults declared in backend/app/core/config.py
#
# `extra="ignore"` is set, so an unknown variable here is silently
# ignored rather than raising. Keep this file in sync with the
# Settings model: backend/app/core/config.py is the source of truth.
# ============================================================


# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
# Valid app_env values: development | test | staging | production
APP_NAME=TenantMind
# Surfaced as the OpenAPI `info.version`. Bump on every release.
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=false
# Health probes are served outside this prefix, on purpose.
API_V1_PREFIX=/api/v1


# ------------------------------------------------------------
# Database (Phase 2 - implemented)
# ------------------------------------------------------------
# The app starts without a database in development when this is empty;
# set it to enable persistence, migrations and ingestion tracking. The
# URL commonly embeds a password, so it is read as a masked secret.
# For the compose PostgreSQL (role `tenantmind_test`, DB created with
# `docker compose exec postgres createdb -U tenantmind_test tenantmind`):
#     DATABASE_URL=postgresql+psycopg://tenantmind_test:<password>@127.0.0.1:5432/tenantmind
DATABASE_URL=


# ------------------------------------------------------------
# Redis (Phase 5 - Celery broker)
# ------------------------------------------------------------
# Connected as of Phase 5 Step 1. This is the Celery broker AND the
# Celery result backend; one value serves both, read in exactly one
# place, backend/app/workers/celery_app.py. No CELERY_* settings
# exist because none are needed: everything else about the worker is
# a property of the code, not of the deployment.
#
# The URL commonly embeds the password, so it is read as a masked
# secret and is never printed. Only `redis://` and `rediss://` are
# accepted; anything else is refused at startup rather than silently
# falling back to Celery's amqp://localhost default, which would
# produce a worker that starts and delivers nothing.
#
# The password inside the URL must be percent-encoded — kombu parses
# this with urllib.parse, so a raw /, @, : or # raises a ValueError
# instead of connecting. `python -c "import secrets;
# print(secrets.token_urlsafe(32))"` produces a safe one.
#
# For the disposable local Redis that docker-compose.yml brings up:
#   REDIS_URL=redis://:<password>@127.0.0.1:6379/0
REDIS_URL=redis://localhost:6379/0


# ------------------------------------------------------------
# Qdrant (Phase 2.5)
# ------------------------------------------------------------
# Connected: ingestion writes into it. These two values are the same as
# the ones documented in full under "Vector store (Phase 2.5 - Qdrant)"
# below, which also covers QDRANT_TIMEOUT_SECONDS.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=


# ------------------------------------------------------------
# LLM (Phase 4 - implemented)
# ------------------------------------------------------------
# The generation layer calls the Google Generative Language API.
# `gemini` is the only supported value today.
LLM_PROVIDER=gemini
# The model answers are produced by. Unlike the security values in the
# JWT section, a nonexistent model name is not refused at startup: it
# surfaces as a provider error on the first request instead.
LLM_MODEL=gemini-3.5-flash
GEMINI_API_KEY=


# ------------------------------------------------------------
# Retrieval (Phase 4 - implemented)
# ------------------------------------------------------------
# How many chunks a query retrieves, and the character ceiling on the
# evidence block handed to the model. Retrieval drops whole chunks to
# stay inside the context budget rather than slicing one.
QUERY_TOP_K=5
QUERY_MAX_CONTEXT_CHARS=12000
# Longest question accepted, in characters. Refused with 422 beyond it,
# not truncated: shortening a question answers one the user did not ask.
QUERY_MAX_QUESTION_CHARS=500


# ------------------------------------------------------------
# Advanced retrieval (Phase 6 - implemented)
# ------------------------------------------------------------
# Hybrid retrieval fuses dense vectors with PostgreSQL BM25 (RRF);
# disable to fall back to Phase 4 dense-only search. Reranking applies
# a cross-encoder to the fused candidates.
HYBRID_RETRIEVAL_ENABLED=true
RERANK_ENABLED=true
# Cross-encoder model; leave unset for the default small/fast choice.
# RERANK_MODEL=
# Maximum candidates fetched from each retriever before fusion.
HYBRID_CANDIDATE_LIMIT=50


# ------------------------------------------------------------
# Security (Phase 2 - implemented)
# ------------------------------------------------------------
# Access tokens are JWTs signed with JWT_SECRET_KEY. Refresh tokens are
# opaque random strings stored only as a SHA-256 digest; they are not
# JWTs and are not signed.
#
# Generate a development secret with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# There is intentionally NO default. Signing or verifying a token with
# an unset, blank, whitespace-only or placeholder secret raises rather
# than falling back, in EVERY environment - not only production - because
# a secret that works in development is one that eventually reaches
# production. It must be at least 32 characters.
#
# In production, inject this from your platform's secret manager
# rather than from a file, and never commit a real value here.
JWT_SECRET_KEY=
# The only accepted value. Pinned rather than configurable: an algorithm
# read from configuration is an algorithm an attacker can influence, and
# this service is single-tenant-signed with no key distribution to justify
# anything asymmetric.
JWT_ALGORITHM=HS256
# Access token lifetime. Deliberately short - a stolen access token is
# only useful for this long, which is why no per-request blocklist lookup
# is needed.
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Refresh token lifetime. Rotated on every use: each refresh issues a new
# refresh token and revokes the old one, so a replayed token is detectable.
REFRESH_TOKEN_EXPIRE_DAYS=7


# ------------------------------------------------------------
# CORS
# ------------------------------------------------------------
# Allowed frontend origins for the Next.js client. Accepts either a JSON
# array (as below) or a comma-separated string, e.g.
#     CORS_ORIGINS=http://localhost:3000,https://app.example.com
CORS_ORIGINS=["http://localhost:3000"]


# ------------------------------------------------------------
# Uploads
# ------------------------------------------------------------
# Maximum accepted upload size, in megabytes. Enforced while the body is
# written, not after it has been received: a request larger than this is
# refused with 413 and the partial file is removed. Set to 0 to refuse every
# upload, which is a useful way to disable ingestion while investigating.
MAX_UPLOAD_SIZE_MB=10

# Where uploaded documents are written, relative to the repository root or
# as an absolute path.
#
# The directory layout beneath it is TenantMind's own and is not configurable:
# one subdirectory per tenant, named with the tenant's UUID in lowercase hex,
# holding files named by an opaque storage key that is never exposed through the
# API. Configuring the root does not change any of that.
#
# Resolved against the repository root rather than the working directory, so the
# default means the same directory whether the API is started from backend/ or
# from the repository root. That distinction is not academic: a relative default
# resolved against the working directory splits uploads across two directories
# depending on how the server was launched, and the symptom is documents
# appearing to vanish.
STORAGE_ROOT=./storage


# ------------------------------------------------------------
# Rate limiting (Phase 5 - declared, not enforced)
# ------------------------------------------------------------
# Requests per minute. Declared only; Redis-backed limiting is not
# implemented.
RATE_LIMIT_PER_MINUTE=60
# Rate limit window in seconds. Default 60 matches the per-minute rate.
RATE_LIMIT_WINDOW_SECONDS=60


# ------------------------------------------------------------
# Query cache (Phase 7 - implemented)
# ------------------------------------------------------------
# Time-to-live for cached query responses, in seconds. 0 disables caching.
QUERY_CACHE_TTL_SECONDS=300


# ------------------------------------------------------------
# Ingestion reconciliation (Phase 5 Step 4B - implemented)
# ------------------------------------------------------------
# How long a document may stay `processing` before it is considered
# stale and eligible for re-enqueueing. Longer than any normal
# ingestion run, short enough that a stuck job is noticed.
INGESTION_STALE_THRESHOLD_SECONDS=300


# ------------------------------------------------------------
# Vector store (Phase 2.5 - Qdrant)
# ------------------------------------------------------------
# Base URL of the Qdrant instance. TenantMind creates one collection per
# tenant, named tenant_<tenant uuid hex>, and never creates a collection
# per request. Collections use the Cosine distance metric and are created
# at EMBEDDING_DIMENSION below; a collection cannot be resized, so
# changing that value afterwards requires deleting and re-ingesting
# each tenant's documents.
QDRANT_URL=http://localhost:6333

# API key for a Qdrant instance that requires one. Leave unset for the
# unauthenticated local server. It is sent as a request header and is
# never logged; do not put it in QDRANT_URL, which is the one value here
# that routinely appears in logs and tracebacks.
# QDRANT_API_KEY=

# Seconds to wait on a single Qdrant operation. Ingestion is synchronous
# in this phase and holds a database connection while it waits, so this
# is also an upper bound on how long that connection is held.
QDRANT_TIMEOUT_SECONDS=5


# ------------------------------------------------------------
# Embeddings (Phase 2.5)
# ------------------------------------------------------------
# Which embedding implementation to use. "gemini" calls the Google
# embeddings API; "static" returns one fixed vector for every input
# and exists so the pipeline can be exercised without an external
# dependency.
#
# "static" is REFUSED when APP_ENV=production. It is not less secure,
# it is useless: every text maps to the same point, so every query
# would retrieve the same chunk while every status endpoint reported
# success. Prefer leaving this unset.
EMBEDDING_PROVIDER=gemini

# The embedding model. "text-embedding-004" produces
# EMBEDDING_DIMENSION-dimensional vectors. Changing either value
# requires recreating existing collections; the application refuses to
# ingest rather than write vectors a collection cannot hold.
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768

# How many chunks one embedding request may carry. The provider's own
# per-request limit is applied on top of this.
EMBEDDING_BATCH_SIZE=100

# Base URL of the Google Generative Language API. Exposed so a
# different API version can be selected without a code change.
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# API key for the embedding provider. Required by EMBEDDING_PROVIDER=gemini
# and read in exactly one place, app.rag.embeddings.build_embedding_provider,
# which raises EmbeddingProviderUnavailable - naming this variable - when it
# is absent or blank. Setting the environment variable is the only supported
# way to supply it.
#
# Note WHERE that is checked, because it is not at startup. A production
# Settings is built fine without this key, on purpose: a third party's
# credential is not this service's own security posture, and refusing to start
# would take the whole API down for a fault that can only break ingestion.
# Requiring it at startup also couples unrelated phases - a production
# assertion about a strong JWT secret would start failing because of a field
# it knows nothing about. See Settings._validate_production_settings.
#
# EMBEDDING_PROVIDER=static needs no key at all; see EMBEDDING_PROVIDER above.
# GEMINI_API_KEY=


# ------------------------------------------------------------
# Chunking (Phase 2.5)
# ------------------------------------------------------------
# Chunk size and overlap, in characters. Character-based rather than
# token-based so that chunking needs no tokenizer and no dependency on
# whichever embedding model is configured.
#
# Chunking is applied one page at a time, so a page holding less than
# CHUNK_SIZE_CHARS yields one short chunk rather than being padded. That
# is deliberate: it keeps every chunk's page citation exact.
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=200


# ============================================================
# Deferred configuration - not currently consumed by TenantMind
# ============================================================
# These are recorded as decisions rather than settings, so the
# reasoning is visible instead of invented later.
#
# Phase 5 - asynchronous ingestion
#     DECIDED AGAINST in Phase 5 Step 1: CELERY_BROKER_URL and
#     CELERY_RESULT_BACKEND as separate settings. REDIS_URL above is
#     both, deliberately — two settings let a deployment enqueue on one
#     Redis and read results from another, and the symptom of getting
#     that wrong is every task appearing to hang with nothing in the
#     logs to say why. Celery keys the two completely separately inside
#     one server, so sharing a database is safe and one value makes the
#     mismatch unrepresentable.
#     Redis-backed rate limiting is declared above but not implemented.
#
# Phase 2.6 / Phase 6 became concrete settings and moved out of this
# section when they shipped: QUERY_TOP_K, QUERY_MAX_CONTEXT_CHARS and
# QUERY_MAX_QUESTION_CHARS (Phase 4), and HYBRID_RETRIEVAL_ENABLED,
# RERANK_ENABLED, RERANK_MODEL and HYBRID_CANDIDATE_LIMIT (Phase 6).
#
# DECIDED against in Phase 2.5, not deferred: a local embedding model.
#     A local sentence-transformers model (all-MiniLM-L6-v2, 384
#     dimensions) was the original intention. It is not a setting waiting
#     for its phase - it was declined, and the API model configured above
#     is what ships: torch cannot be pinned to a CPU-only wheel through a
#     plain requirements file, so the alternative is a ~2.5 GB CUDA
#     download for a deployment decision rather than a pipeline one. See
#     the note in backend/requirements.txt. app.rag.embeddings is an
#     abstraction precisely so coming back to it is one subclass and one
#     factory branch.
